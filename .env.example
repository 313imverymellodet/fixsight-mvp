# Copy this file to .env and add your key.
# Leave OPENAI_API_KEY blank to run the built-in demo mode (no API calls).
OPENAI_API_KEY=

# Multimodal model used for live analysis + verification (Responses API,
# strict json_schema output). Must be a real model your OpenAI account can
# access, e.g. gpt-4o or gpt-4.1. Defaults to gpt-4o if unset.
OPENAI_MODEL=gpt-4o

# Port the server listens on. Most hosts inject this automatically.
PORT=3000

# Network interface. Defaults to 0.0.0.0 (all interfaces) for container hosts.
# HOST=0.0.0.0
